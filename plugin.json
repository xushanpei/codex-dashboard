{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-pulse",
  "version": "0.1.3",
  "description": "Live local Codex status, quota, and token usage for macOS and Windows.",
  "author": {
    "name": "xushanpei",
    "url": "https://github.com/xushanpei"
  },
  "homepage": "https://github.com/xushanpei/codex-pulse",
  "repository": "https://github.com/xushanpei/codex-pulse",
  "license": "MIT",
  "keywords": ["codex", "tokens", "quota", "status"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codex Pulse",
        "shortDescription": "Codex status at a glance",
        "longDescription": "See local Codex chat activity, quota, context remaining, and token trends.",
        "developerName": "xushanpei",
        "category": "Productivity",
        "capabilities": ["Read"],
        "logo": "./assets/app-icon.png",
        "defaultPrompt": "Show my Codex Pulse status."
      }
    }
  }
}
